engine-strict=true

# `provenance` is deliberately NOT set here.
#
# npm can only generate provenance from a CI provider with OIDC (GitHub Actions), so
# setting it in project config makes every local `pnpm publish` abort with
# `EUSAGE: Automatic provenance generation not supported for provider: null` — breaking
# the local `pnpm publish`, which is the only publish path (this repository has no CI). It
# also cannot be waved off at the call site:
# `--provenance=false` is not a `pnpm publish` flag, so pnpm drops it and npm reads this
# file anyway.
